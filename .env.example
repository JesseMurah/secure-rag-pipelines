# Anthropic — generation
ANTHROPIC_API_KEY=

# Voyage AI — embeddings (200M free tokens on voyage-4)
VOYAGE_API_KEY=

# Pinecone — index must be dimension 1024 for voyage-4
PINECONE_API_KEY=
PINECONE_INDEX_NAME=secure-rag-demo

# OpenFGA — local docker. Fill store/model ids from `bash fga/bootstrap.sh`
FGA_API_URL=http://localhost:8080
FGA_STORE_ID=
FGA_MODEL_ID=

# Stage parachute — replay the Pinecone and Claude calls from a recorded
# JSON keyed on (user, mode, question). OpenFGA and the filtering stay
# live, so the authorization beat is still real.
# NOT WIRED UP YET: no code reads this, so setting it to 1 changes nothing.
DEMO_CACHE=0
